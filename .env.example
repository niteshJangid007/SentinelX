# Copy to .env only when configuring manually. The local launcher generates
# POSTGRES_PASSWORD securely if .env does not exist. Never commit .env.
# Generate a URL-safe random password; no default password is supplied.
POSTGRES_PASSWORD=
POSTGRES_USER=sentinelx
POSTGRES_DB=sentinelx
SENTINELX_POSTGRES_PORT=55432
# The launcher sets DATABASE_URL for host Uvicorn; Compose uses database host db.
# Do not paste credentials into chat or save DATABASE_URL in source control.
# Optional exact frontend origins, comma separated; omitted means no cross-origin access.
# SECUREFLOW_CORS_ORIGINS=https://secureflow.example.com
# Single-process auth request limits (both login and registration, per direct peer).
# SECUREFLOW_AUTH_LIMIT=30
# SECUREFLOW_AUTH_WINDOW_SECONDS=60
# SECUREFLOW_AUTH_MAX_PEERS=10000
